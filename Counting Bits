Given an integer n, return an array ans of length n + 1 such that for each i (0 <= i <= n), ans[i] is the number of 1's in the binary representation of i.
Example 1:
Input: n = 2
Output: [0,1,1]
Explanation:
0 --> 0
1 --> 1
2 --> 10

SOLUTION:
class Solution {
    public int[] countBits(int n) {
        int[] res = new int[n+1];
        exec(res, 1, 1, n);
        return res;
    }

    private void exec(int[] res, int x, int c, int n) {
        if (x > n) return;
        res[x] = c;
        exec(res, x * 2, c, n);
        exec(res, x * 2 + 1, c + 1, n); 
    }
}
