Given the head of a singly linked list, reverse the list, and return the reversed list.

SOLUTION:
class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode curr=head;
        ListNode prev=null;
        while(curr!=null){
            ListNode cv=curr.next;
            curr.next=prev;
            prev=curr;
            curr=cv;
        }
        return prev;
    }
}
